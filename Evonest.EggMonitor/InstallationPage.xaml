<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Evonest.EggMonitor.InstallationPage"
             Title="Installation">
    <VerticalStackLayout Margin="20">
        <Entry x:Name="HatchNameEntry"
            Placeholder="Kuluckaniza isim giriniz"
            FontSize="Medium"
            HorizontalOptions="Center"
            Margin="10"
            
            />

        <Picker x:Name="BirdTypePicker"
                Title=" Kuş cinsini seçiniz"
                FontSize="Medium"
                HorizontalOptions="Center"  >
            <Picker.Items>
                <x:String>Tavuk</x:String>
                <x:String>Kaz</x:String>
                <x:String>Bıldırcın</x:String>
                <x:String>Ördek</x:String>
            </Picker.Items>
        </Picker>

        <Entry x:Name="EggCountEntry"
               Placeholder="Yumurta sayısını giriniz"
               Keyboard="Numeric"
               FontSize="Medium"
               HorizontalOptions="Center" 
               Margin="10"/>
        <VerticalStackLayout Margin="10" BackgroundColor="LightSlateGray">
            <Label Text="Makine yumurta çevirme tipi" VerticalOptions="Center" HorizontalOptions="Center"/>
            <HorizontalStackLayout HorizontalOptions="Center" Margin="10">
                <Label Text="Manuel" HorizontalOptions="Center"/>
                <Switch x:Name="MachineTypeSwitch" HorizontalOptions="Center"></Switch>
                <Label Text="Otomatik" HorizontalOptions="Center"/>

            </HorizontalStackLayout>    
        </VerticalStackLayout>
      
        <Grid ColumnDefinitions="*,*">
            <DatePicker x:Name="StartingDatePicker" Grid.Column="0" Format="dd/mm/yy" />
            <TimePicker x:Name="StartingTimePicker" Grid.Column="1" Format="HH/mm" />
        </Grid>

        <Button Text="Kurulumu bitir" Clicked="OnInstallationClicked"></Button>

    </VerticalStackLayout>
</ContentPage>