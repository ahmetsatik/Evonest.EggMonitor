<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Evonest.EggMonitor.MainPage">
    <ContentPage.Content>
                
        <Grid RowDefinitions="200,200,*,*" ColumnDefinitions="*" Margin="20">
            <Border Grid.Row="0" StrokeShape="100" HeightRequest="200" WidthRequest="200">
            <Grid BackgroundColor="DarkGray">
                <Label x:Name="CurrentDayLabel" 
                       HorizontalOptions="Center" 
                       VerticalOptions="Center" 
                       Text="1.gün" 
                       FontSize="50"
                       TextColor="Red"/>
            </Grid>
            </Border>

            <Border HeightRequest="140" Grid.Row="1" StrokeShape="20">
            <Grid  ColumnDefinitions="*" Padding    ="10,10,10,10" RowDefinitions="75,50" >
                <Entry Grid.Row="0" Placeholder=" Nem giriniz" Keyboard="Numeric" HorizontalOptions="Start" WidthRequest="175" HeightRequest="50"/>
                <Entry Grid.Row="0" Placeholder=" Sıcaklık giriniz" Keyboard="Numeric" HorizontalOptions="End" WidthRequest="175" HeightRequest="50        "/>
                <Button Grid.Row="1" Text="Değerleri kaydet." WidthRequest="150" VerticalOptions="Start" HorizontalOptions="End" />
            </Grid>
            </Border>

            <Border HeightRequest="200" Grid.Row="2" StrokeShape="20" Padding="30,50">
                <CollectionView ItemsSource="{Binding IncubationStages}" HorizontalScrollBarVisibility="Never" >
                    <CollectionView.ItemsLayout>
                        <LinearItemsLayout Orientation="Horizontal" ItemSpacing="200"/>
                    </CollectionView.ItemsLayout>
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <VerticalStackLayout>
                                <Button Text="{Binding DayNumber}"
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type CollectionView}}, Path=BindingContext.StageSelectedCommand}"
                                        CommandParameter="{Binding .}"
                                        HeightRequest="100"
                                        WidthRequest="100"
                                        
                                        CornerRadius="100"></Button>
                            </VerticalStackLayout>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </Border>


            <Button Grid.Row="3"  Text="Kuluçka özelliklerini göster" Margin="50" Clicked="OnShowHatchClicked"/>

        </Grid>

    </ContentPage.Content>
</ContentPage>
