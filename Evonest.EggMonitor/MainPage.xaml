<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Evonest.EggMonitor.MainPage">
    <ContentPage.Content>
                
        <Grid RowDefinitions="200,200,*,*" ColumnDefinitions="*" Margin="20">
            <Grid Grid.Row="0" BackgroundColor="DarkGray">
                <Label x:Name="CurrentDayLabel" 
                       HorizontalOptions="Center" 
                       VerticalOptions="Center" 
                       Text="1.gün" 
                       FontSize="50"
                       TextColor="Red"/>
            </Grid>


            <Border HeightRequest="140" Margin="0,10" Grid.Row="1">
            <Grid  ColumnDefinitions="*" RowDefinitions="75,50" >
                <Entry Grid.Row="0" Placeholder=" Nem giriniz" HorizontalOptions="Start" WidthRequest="175" HeightRequest="50"/>
                <Entry Grid.Row="0" Placeholder=" Sıcaklık giriniz" HorizontalOptions="End" WidthRequest="175" HeightRequest="50        "/>
                <Button Grid.Row="1" Text="Değerleri kaydet."       WidthRequest="150" HorizontalOptions="End" />
            </Grid>
            </Border>   
            <Button Grid.Row="2"  Text="Kuluçka özelliklerini göster" Margin="50" Clicked="OnShowHatchClicked"/>

        </Grid>

    </ContentPage.Content>
</ContentPage>
