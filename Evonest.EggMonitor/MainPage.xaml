<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Evonest.EggMonitor.MainPage">
    <ContentPage.Content>
        <Grid RowDefinitions="50,*">

            
            
            <ScrollView Grid.Row="1">
                <Grid RowDefinitions="200,200,*,*" ColumnDefinitions="*" Margin="20" RowSpacing="10">
                    <Border Grid.Row="0" StrokeShape="100" HeightRequest="200" WidthRequest="200">
                        <Grid BackgroundColor="DarkGray">
                            <Label x:Name="CurrentDayLabel" 
                       HorizontalOptions="Center" 
                       VerticalOptions="Center" 
                       Text="1.gün" 
                       FontSize="50"
                       TextColor="Red"/>
                        </Grid>
                    </Border>

                    <Border StrokeShape="75">
                        <Button Text=" 🔄 " Grid.Row="0" HeightRequest="75" WidthRequest="75" HorizontalOptions="End" VerticalOptions="Start" Clicked="OnSwitchHatch"   />
                    </Border>

               <Border HeightRequest="170" Grid.Row="1" StrokeShape="20">
              <Grid  ColumnDefinitions="*" Padding    ="10,10,10,10" RowDefinitions="75,15, 50" >
                  <Entry Grid.Row="0" x:Name="DailyHumudity" Placeholder=" Nem giriniz" Keyboard="Numeric" HorizontalOptions="Start" WidthRequest="175" HeightRequest="50"/>
                  <Entry Grid.Row="0" x:Name="DailyTemp" Placeholder=" Sıcaklık giriniz" Keyboard="Numeric" HorizontalOptions="End" WidthRequest="175" HeightRequest="50        "/>
                  <Entry Grid.Row="1" x:Name="DailyDescription" Placeholder="Not girniz" HeightRequest="50"                                                                                                                          />
                 <Button Grid.Row="2" Text="Değerleri kaydet." WidthRequest="150" VerticalOptions="End" HorizontalOptions="End" HeightRequest="20" Clicked="TrackSaveClicked" />
             </Grid>
                   
                   
                </Border>

                <Border HeightRequest="200" Grid.Row="2" StrokeShape="20" Padding="30,50">
                <CollectionView ItemsSource="{Binding IncubationStages}" HorizontalScrollBarVisibility="Never" >
                    <CollectionView.ItemsLayout>
                        <LinearItemsLayout Orientation="Horizontal" ItemSpacing="200"/>
                    </CollectionView.ItemsLayout>
                        <CollectionView.ItemTemplate>   
                         <DataTemplate>
                            <VerticalStackLayout>
                                <Button Text="{Binding DayNumber}"
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type CollectionView}}, Path=BindingContext.StageSelectedCommand}"
                                        CommandParameter="{Binding .}"
                                        HeightRequest="100"
                                        WidthRequest="100"
                                        
                                        CornerRadius="100"></Button>
                                   </VerticalStackLayout>
                             </DataTemplate>
                           </CollectionView.ItemTemplate>
                       </CollectionView>
                  </Border>


                 <Button Grid.Row="3"  Text="Kuluçka özelliklerini göster" Margin="50" Clicked="OnShowHatchClicked"/>

                </Grid>
            </ScrollView>

            <Grid ColumnDefinitions="*,40,40" Grid.Column="0" VerticalOptions="Start" BackgroundColor="Blue" ColumnSpacing="10" HeightRequest="50">
                <Button Grid.Column="1" BackgroundColor="Gray" HeightRequest="40" WidthRequest="40" Margin="20" HorizontalOptions="End" Text="M" Clicked="OnManual"   />
                <Button Grid.Column="2" BackgroundColor="Gray" HeightRequest="40" WidthRequest="40" Margin="20" HorizontalOptions="End" Text="A" Clicked="OnSettings"   />

            </Grid>

            <Button Text="+"
                    Grid.Row="0"
                    Grid.RowSpan="2"
                    FontSize="28"
                    FontAttributes="Bold"
                    TextColor="White"
                    WidthRequest="60"
                    HeightRequest="60"
                    CornerRadius="15"
                    HorizontalOptions="End"
                    VerticalOptions="End"
                    Margin="20"
                    ZIndex="10"
                    Clicked="OnAddHatchClicked">
                <Button.Shadow>
                    <Shadow Brush="Black" Offset="5,5" Radius="10" Opacity="0.5"/>
                </Button.Shadow>
            </Button>
        </Grid>
    </ContentPage.Content>
</ContentPage>
