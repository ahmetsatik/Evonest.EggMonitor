<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Evonest.EggMonitor.NewHatchPage"
             Title="Yeni Kuluçka Ekle"
             BackgroundColor="#F5F7FA">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="20">

            <!-- Sayfa Başlığı ve Açıklaması -->
            <VerticalStackLayout Spacing="5" Margin="0,10,0,5">
                <Label Text="Kuluçka Kurulumu" FontSize="22" FontAttributes="Bold" TextColor="#2C3E50" HorizontalOptions="Center"/>
                <Label Text="Yeni kuluçka sürecini başlatmak için bilgileri doldurun." FontSize="13" TextColor="#7F8C8D" HorizontalOptions="Center"/>
            </VerticalStackLayout>

            <!-- ANA FORM KARTI -->
            <Border Stroke="#E0E6ED" StrokeThickness="1" StrokeShape="RoundRectangle 15" BackgroundColor="White" Padding="20">
                <VerticalStackLayout Spacing="18">

                    <!-- Kuluçka Adı -->
                    <VerticalStackLayout Spacing="5">
                        <Label Text="Kuluçka Adı" FontSize="13" FontAttributes="Bold" TextColor="#34495E"/>
                        <Border Stroke="#E0E6ED" StrokeThickness="1" StrokeShape="RoundRectangle 8" BackgroundColor="#F9FBFC" HeightRequest="45">
                            <Entry x:Name="HatchNameEntry" Placeholder="Örn: 1. Parti Tavuklar" TextColor="#2C3E50" Margin="10,0"/>
                        </Border>
                    </VerticalStackLayout>

                    <!-- Kuş Cinsi -->
                    <VerticalStackLayout Spacing="5">
                        <Label Text="Kuş Cinsi" FontSize="13" FontAttributes="Bold" TextColor="#34495E"/>
                        <Border Stroke="#E0E6ED" StrokeThickness="1" StrokeShape="RoundRectangle 8" BackgroundColor="#F9FBFC" HeightRequest="45">
                            <Picker x:Name="BirdTypePicker" Title="Bir tür seçiniz" TextColor="#2C3E50" TitleColor="#BDC3C7" Margin="10,0">
                                <Picker.Items>
                                    <x:String>Tavuk</x:String>
                                    <x:String>Kaz</x:String>
                                    <x:String>Bıldırcın</x:String>
                                    <x:String>Ördek</x:String>
                                </Picker.Items>
                            </Picker>
                        </Border>
                    </VerticalStackLayout>

                    <!-- Yumurta Sayısı -->
                    <VerticalStackLayout Spacing="5">
                        <Label Text="Yumurta Sayısı" FontSize="13" FontAttributes="Bold" TextColor="#34495E"/>
                        <Border Stroke="#E0E6ED" StrokeThickness="1" StrokeShape="RoundRectangle 8" BackgroundColor="#F9FBFC" HeightRequest="45">
                            <Entry x:Name="EggCountEntry" Placeholder="Örn: 30" Keyboard="Numeric" TextColor="#2C3E50" Margin="10,0"/>
                        </Border>
                    </VerticalStackLayout>

                    <!-- Çevirme Tipi (Switch) -->
                    <VerticalStackLayout Spacing="5">
                        <Label Text="Makine Çevirme Tipi" FontSize="13" FontAttributes="Bold" TextColor="#34495E"/>
                        <Border Stroke="#E0E6ED" StrokeThickness="1" StrokeShape="RoundRectangle 8" BackgroundColor="#F9FBFC" Padding="15,10">
                            <Grid ColumnDefinitions="*, Auto, *">
                                <!-- Manuel -->
                                <Label Grid.Column="0" Text="Manuel" FontSize="14" TextColor="#7F8C8D" VerticalOptions="Center" HorizontalOptions="End" Margin="0,0,10,0"/>

                                <!-- Switch -->
                                <Switch Grid.Column="1" x:Name="MachineTypeSwitch" OnColor="#3498DB" VerticalOptions="Center"/>

                                <!-- Otomatik -->
                                <Label Grid.Column="2" Text="Otomatik" FontSize="14" FontAttributes="Bold" TextColor="#3498DB" VerticalOptions="Center" HorizontalOptions="Start" Margin="10,0,0,0"/>
                            </Grid>
                        </Border>
                    </VerticalStackLayout>

                    <!-- Tarih ve Saat (Grid ile yan yana) -->
                    <Grid ColumnDefinitions="*, *" ColumnSpacing="15" Margin="0,5,0,0">

                        <!-- Başlangıç Tarihi -->
                        <VerticalStackLayout Grid.Column="0" Spacing="5">
                            <Label Text="Başlangıç Tarihi" FontSize="13" FontAttributes="Bold" TextColor="#34495E"/>
                            <Border Stroke="#E0E6ED" StrokeThickness="1" StrokeShape="RoundRectangle 8" BackgroundColor="#F9FBFC" HeightRequest="45">
                                <DatePicker x:Name="StartingDatePicker" Format="dd/MM/yyyy" TextColor="#2C3E50" Margin="10,0"/>
                            </Border>
                        </VerticalStackLayout>

                        <!-- Başlangıç Saati -->
                        <VerticalStackLayout Grid.Column="1" Spacing="5">
                            <Label Text="Başlangıç Saati" FontSize="13" FontAttributes="Bold" TextColor="#34495E"/>
                            <Border Stroke="#E0E6ED" StrokeThickness="1" StrokeShape="RoundRectangle 8" BackgroundColor="#F9FBFC" HeightRequest="45">
                                <TimePicker x:Name="StartingTimePicker" Format="HH:mm" TextColor="#2C3E50" Margin="10,0"/>
                            </Border>
                        </VerticalStackLayout>

                    </Grid>

                </VerticalStackLayout>
            </Border>

            <!-- ONAYLAMA BUTONU -->
            <Button Text="Yeni Kuluçkayı Başlat" 
                    Clicked="OnNewHatchClicked" 
                    BackgroundColor="#27AE60" 
                    TextColor="White" 
                    FontAttributes="Bold" 
                    FontSize="16" 
                    CornerRadius="12" 
                    HeightRequest="55" 
                    Margin="0,10,0,30">
                <Button.Shadow>
                    <!-- Butona hafif bir derinlik/gölge veriyoruz -->
                    <Shadow Brush="#27AE60" Offset="0,4" Radius="8" Opacity="0.3"/>
                </Button.Shadow>
            </Button>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>