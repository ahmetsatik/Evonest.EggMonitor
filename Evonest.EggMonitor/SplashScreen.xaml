<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Evonest.EggMonitor.SplashScreen"
             BackgroundColor="#F5F7FA" 
             NavigationPage.HasNavigationBar="False"
             Shell.NavBarIsVisible="False">

    <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Spacing="50">

        <Border Stroke="Transparent" BackgroundColor="Transparent" HorizontalOptions="Center">
            <Image Source="evonest_logo.webp" 
                   WidthRequest="300" 
                   HeightRequest="110" 
                   Aspect="AspectFit"/>
        </Border>

        <VerticalStackLayout Spacing="15">
            <ActivityIndicator IsRunning="True" 
                               Color="#3498DB" 
                               WidthRequest="40" 
                               HeightRequest="40"
                               HorizontalOptions="Center"/>
        </VerticalStackLayout>

    </VerticalStackLayout>
</ContentPage>