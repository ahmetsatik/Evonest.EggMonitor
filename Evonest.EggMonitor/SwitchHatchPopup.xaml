<?xml version="1.0" encoding="utf-8" ?>
<toolkit:Popup xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
               xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
               xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
               x:Class="Evonest.EggMonitor.SwitchHatchPopup">
    <Border StrokeShape="RoundRectangle 20" 
            BackgroundColor="{AppThemeBinding Light=White, Dark=#1E1E1E}" 
            Padding="20" 
            WidthRequest="300" 
            HeightRequest="400">

        <Grid RowDefinitions="Auto, *">
            <Label Text="Kuluçka Seç" 
                   FontSize="20" 
                   FontAttributes="Bold" 
                   HorizontalOptions="Center" 
                   Margin="0,0,0,15" 
                   TextColor="{AppThemeBinding Light=#2C3E50, Dark=#E0E6ED}"/>

            <CollectionView Grid.Row="1" x:Name="HatchesCollection" SelectionMode="Single" SelectionChanged="OnHatchSelected">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border Stroke="{AppThemeBinding Light=#E0E6ED, Dark=#333333}" 
                                StrokeThickness="1" 
                                StrokeShape="RoundRectangle 15" 
                                BackgroundColor="{AppThemeBinding Light=White, Dark=#252526}" 
                                Margin="15,5,15,10" 
                                Padding="15">

                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup Name="CommonStates">
                                    <VisualState Name="Normal" />
                                    <VisualState Name="Selected">
                                        <VisualState.Setters>
                                            <Setter Property="BackgroundColor" Value="{AppThemeBinding Light=#F4F9F9, Dark=#1B3A4B}" />
                                            <Setter Property="Stroke" Value="#3498DB" />
                                        </VisualState.Setters>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>

                            <Grid RowDefinitions="Auto, Auto, Auto">

                                <Grid Grid.Row="0" ColumnDefinitions="*, Auto" ColumnSpacing="10">
                                    <Label Grid.Column="0" 
                                           Text="{Binding Name}" 
                                           FontAttributes="Bold" 
                                           FontSize="18" 
                                           TextColor="{AppThemeBinding Light=#2C3E50, Dark=#E0E6ED}" 
                                           VerticalOptions="Center" 
                                           LineBreakMode="TailTruncation"/>

                                    <Border Grid.Column="1" 
                                            StrokeShape="RoundRectangle 8" 
                                            BackgroundColor="{AppThemeBinding Light=#EBF5FB, Dark=#154360}" 
                                            Stroke="Transparent" 
                                            Padding="8,4" 
                                            VerticalOptions="Center">
                                        <Label Text="{Binding StartDate, StringFormat='{0:dd.MM.yyyy}'}" 
                                               FontSize="12" 
                                               TextColor="{AppThemeBinding Light=#2980B9, Dark=#5DADE2}" 
                                               FontAttributes="Bold"/>
                                    </Border>
                                </Grid>

                                <BoxView Grid.Row="1" HeightRequest="1" Color="{AppThemeBinding Light=#F1F2F6, Dark=#333333}" Margin="0,12"/>

                                <Grid Grid.Row="2" ColumnDefinitions="*, Auto">

                                    <VerticalStackLayout Grid.Column="0" VerticalOptions="Center">
                                        <Label Text="Yumurta Sayısı" FontSize="11" TextColor="{AppThemeBinding Light=#7F8C8D, Dark=#95A5A6}"/>
                                        <Label Text="{Binding EggCount}" FontAttributes="Bold" FontSize="16" TextColor="{AppThemeBinding Light=#34495E, Dark=#E0E6ED}"/>
                                    </VerticalStackLayout>

                                    <Label Grid.Column="1" Text="Seç ➔" FontSize="12" FontAttributes="Italic" TextColor="{AppThemeBinding Light=#BDC3C7, Dark=#4D5656}" VerticalOptions="Center"/>

                                </Grid>

                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </Grid>
    </Border>
</toolkit:Popup>