<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Evonest.EggMonitor.TrackerPage"
             Title="Günlük Takip Geçmişi"
             BackgroundColor="#F5F7FA">

    <Grid Padding="15">

        <CollectionView ItemsSource="{Binding TrackerItems}" VerticalScrollBarVisibility="Never">
            <CollectionView.ItemsLayout>
                <!-- Öğeler arası o devasa 50 birimlik boşluğu modern bir ölçü olan 15'e indirdik -->
                <LinearItemsLayout Orientation="Vertical" ItemSpacing="15"/>
            </CollectionView.ItemsLayout>

            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <!-- Modern Kart Tasarımı -->
                    <Border Stroke="#E0E6ED" StrokeThickness="1" StrokeShape="RoundRectangle 15" BackgroundColor="White" Padding="15">
                        <Grid RowDefinitions="Auto, Auto, Auto" RowSpacing="10">

                            <!-- 1. SATIR: GÜN ROZETİ VE TARİH -->
                            <Grid Grid.Row="0" ColumnDefinitions="Auto, *">
                                <!-- Gün Kutusu (Badge/Rozet görünümü) -->
                                <Border Grid.Column="0" BackgroundColor="#E8F8F5" StrokeShape="RoundRectangle 8" Padding="10,5" VerticalOptions="Center">
                                    <Label Text="{Binding DayNumber, StringFormat='{0}. Gün'}" 
                                           FontSize="14" 
                                           FontAttributes="Bold" 
                                           TextColor="#27AE60" />
                                </Border>

                                <!-- Tarih -->
                                <Label Grid.Column="1" 
                                       Text="{Binding DateText}" 
                                       FontSize="12" 
                                       TextColor="#7F8C8D" 
                                       HorizontalOptions="End" 
                                       VerticalOptions="Center" />
                            </Grid>

                            <!-- AYIRICI ÇİZGİ -->
                            <BoxView Grid.Row="1" HeightRequest="1" Color="#F1F2F6" Margin="0,5"/>

                            <!-- 2. SATIR: DEĞERLER VE AÇIKLAMA -->
                            <Grid Grid.Row="2" RowDefinitions="Auto, Auto" RowSpacing="12">

                                <!-- Sıcaklık ve Nem Değerleri -->
                                <HorizontalStackLayout Grid.Row="0" Spacing="8" VerticalOptions="Center">
                                    <Label Text="🌡️" FontSize="14" VerticalOptions="Center"/>
                                    <Label Text="Kabin Değerleri:" FontSize="13" TextColor="#7F8C8D" VerticalOptions="Center"/>
                                    <Label Text="{Binding TempAndHumidity}" FontSize="14" FontAttributes="Bold" TextColor="#2C3E50" VerticalOptions="Center"/>
                                </HorizontalStackLayout>

                                <!-- Not / Açıklama Kutusu -->
                                <VerticalStackLayout Grid.Row="1" Spacing="5">
                                    <Label Text="Açıklama / Not:" FontSize="12" TextColor="#7F8C8D"/>
                                    <Border Stroke="#E0E6ED" StrokeThickness="1" StrokeShape="RoundRectangle 8" BackgroundColor="#F9FBFC" Padding="10">
                                        <Label Text="{Binding Description}" FontSize="13" TextColor="#34495E"/>
                                    </Border>
                                </VerticalStackLayout>

                            </Grid>

                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

    </Grid>
</ContentPage>